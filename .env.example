# Copy this file to .env before the first `docker compose up --build`.
# Use strong, unique values for passwords and tokens outside local development.
PATIENT_DB_PASSWORD=change-me-patient-db-password
NOTIFICATION_DB_PASSWORD=change-me-notification-db-password

# Kept for compatibility with the existing local environment files.
PATIENT_DB_PASSWORD_URL=change-me-patient-db-password
NOTIFICATION_DB_PASSWORD_URL=change-me-notification-db-password
