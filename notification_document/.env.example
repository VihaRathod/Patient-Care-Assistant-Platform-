## This value must match patient_management/.env.
INTERNAL_SERVICE_TOKEN=replace_with_an_internal_service_token

# Optional email sender shown in MailHog during local development.
EMAIL_FROM=notifications@patientcare.local

# S3 bucket for generated PDFs. Keep the bucket private; the service returns
# short-lived presigned URLs rather than making clinical documents public.
DOCUMENTS_S3_BUCKET=replace_with_your_private_s3_bucket
DOCUMENTS_S3_PREFIX=patient-care/documents
AWS_REGION=ap-southeast-2
DOCUMENTS_S3_ENCRYPTION=AES256
# Set this when the bucket policy requires SSE-KMS.
# DOCUMENTS_S3_KMS_KEY_ID=alias/patient-care-documents
DOCUMENT_LINK_EXPIRY_SECONDS=3600

REMINDER_HOURS_BEFORE=24
SCHEDULER_INTERVAL_MINUTES=15
